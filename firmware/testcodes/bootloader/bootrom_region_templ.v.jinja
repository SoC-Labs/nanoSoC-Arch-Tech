// UNITS, because this number used to mean two different things in one file:
//   ROM_ADDR_W is a WORD address width. {{ rom_module_name }} has a
//   word_addr port ROM_ADDR_W bits wide and holds 2**ROM_ADDR_W 32-bit words,
//   so the physical boot ROM is 4 * 2**ROM_ADDR_W BYTES.
//   ROM_ADDR_W = 11  ->  2048 words  ->  8 KB, which is what the SoC config
//   package's BOOTROM_ADDR_W, the generated bootrom.sv and the bootloader
//   linker script (LENGTH = 0x2000) all say.
// The AHB byte address therefore has ROM_ADDR_W+2 significant bits, and the
// word address is HADDR[ROM_ADDR_W+1:2]. This slice used to read
// HADDR[ROM_ADDR_W-1:2] -- ROM_ADDR_W taken as a BYTE width -- which drove only
// 9 of the 11 word_addr bits. The top two bits sat at zero, so only the first
// 512 words (2 KB) of an 8 KB ROM were reachable and everything above 0x7FF
// aliased down onto it, silently. stage0 was 1420 bytes, so nothing broke; a
// bootloader over 2 KB would have fetched the wrong instructions with no
// message from any tool.
module {{ region_module_name }} #(
    parameter    SYS_ADDR_W  = 32,  // System Address Width
    parameter    SYS_DATA_W  = 32,  // System Data Width
    parameter    ROM_ADDR_W  = {{ word_address_width }}   // Boot ROM WORD address width: 4 * 2**ROM_ADDR_W bytes
)(
    input  wire                   HCLK,       // Clock

    // AHB connection to Initiator
    input  wire                   HSEL,
    input  wire  [SYS_ADDR_W-1:0] HADDR,
    input  wire             [1:0] HTRANS,
    input  wire             [2:0] HSIZE,
    input  wire             [3:0] HPROT,
    input  wire                   HWRITE,
    input  wire                   HREADY,
    input  wire  [SYS_DATA_W-1:0] HWDATA,

    output wire                   HREADYOUT,
    output wire                   HRESP,
    output wire  [SYS_DATA_W-1:0] HRDATA
);

    // AHB decode — ROM read enable
    wire en = HSEL & HTRANS[1] & HREADY & !HWRITE;

    // The word address width {{ rom_module_name }} was actually generated with
    // (bootrom_gen.py -a). Nothing in THIS file compares it: the comparison is
    // flows/checks/check_bootrom_reach.sh, run by `make bootrom`, which fails if
    // this differs from the ROM's word_addr width, or if the ROM_ADDR_W value
    // the SoC passes (resolved through the SoC config package) is smaller than
    // it -- the case where part of the ROM is unreachable through a correct
    // slice. A ROM_ADDR_W larger than this only means the ROM repeats inside a
    // larger region; that is reported under MEM_SIZE_CHECK.
    localparam ROM_WORD_ADDR_W = {{ word_address_width }};

    // ROM instance — {{ rom_module_name }} is generated by bootrom_gen.py
    {{ rom_module_name }} u_bootrom (
        .clk       (HCLK),
        .en        (en),
        .word_addr (HADDR[ROM_ADDR_W+1:2]),
        .out_data  (HRDATA)
    );

    // Always ready, always OKAY
    assign HREADYOUT = 1'b1;
    assign HRESP     = 1'b0;

endmodule
