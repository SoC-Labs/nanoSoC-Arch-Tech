#-----------------------------------------------------------------------------
# Description:
# This Makefile generates the bootrom files for NanoSoC. This has been separated out
# of the software compilation makefile for simplicity.
#
# Outputs (all in build/firmware/gcc/stage0/out/):
#   stage0.hex       — Verilog hex file from GCC compilation
#   bootrom.sv       — Synthesizable Verilog ROM module
#   bootrom.bintxt   — Binary text representation
#-----------------------------------------------------------------------------

#------------------------------------------------------------------------
# Read the AutoConfig Overloaded Variables
#------------------------------------------------------------------------
include $(SOCLABS_PROJECT_DIR)/autoconfig
export TOOL_CHAIN

# Software make options
# - Pass onto the software makefile to define targetted CPU type
# You can append additional make options for testcode here
SW_MAKE_OPTIONS = CPU_PRODUCT=CORTEX_M0 TOOL_CHAIN=$(TOOL_CHAIN)

# Bootrom Parameters:
# Stage 0 bootloader image
BOOTLOADER            ?= stage0
BOOTROM_ADDRW         ?= 8
BOOTROM_MODULE        ?= bootrom
BOOTROM_REGION_MODULE ?= nanosoc_region_bootrom
BOOTROM_OUT_DIR       ?= $(SOCLABS_PROJECT_DIR)/build/firmware/bootloader/$(BOOTLOADER)/out
BOOTROM_HEX           ?= $(BOOTROM_OUT_DIR)/$(BOOTLOADER).hex

# Boot ROM generation
#--------------------------------------------------------------------------------
# All outputs go next to the hex file in the firmware build directory
BOOTROM_SV         := $(BOOTROM_OUT_DIR)/$(BOOTROM_MODULE).sv
BOOTROM_BIN        := $(BOOTROM_OUT_DIR)/bootrom.bintxt
BOOTROM_REGION_SV  := $(BOOTROM_OUT_DIR)/$(BOOTROM_REGION_MODULE).v

BOOTROM_SIM_DIR := $(SIM_TOP_DIR)/bootloader
BOOTROM_SIM_HEX := $(BOOTROM_SIM_DIR)/$(BOOTLOADER).hex

# Tools
BOOTROM_GEN_PY := $(SOCLABS_NANOSOC_ARCH_TECH_DIR)/firmware/testcodes/bootloader/bootrom_gen.py

bootrom: $(BOOTROM_SV) $(BOOTROM_BIN) $(BOOTROM_REGION_SV) $(BOOTROM_SIM_HEX)

# Generate the Boot ROM Verilog, region wrapper, and Binary Text files from the bootloader hex file
$(BOOTROM_SV) $(BOOTROM_BIN) $(BOOTROM_REGION_SV): $(BOOTROM_HEX) $(BOOTROM_GEN_PY) | $(BOOTROM_OUT_DIR)
	@echo "Generating Boot ROM Verilog, region wrapper, and Binary Text files"
	@echo "Toolchain: $(TOOL_CHAIN)"
	@python3 $(BOOTROM_GEN_PY) -a $(BOOTROM_ADDRW) -i $(BOOTROM_HEX) -t $(TOOL_CHAIN) \
		-m $(BOOTROM_MODULE) -v $(BOOTROM_SV) -b $(BOOTROM_BIN) \
		-R $(BOOTROM_REGION_MODULE) -r $(BOOTROM_REGION_SV)

# Copy the bootloader hex file to the simulation directory
$(BOOTROM_SIM_HEX): $(BOOTROM_HEX) | $(BOOTROM_SIM_DIR)
	@echo "Copying Boot ROM hex file to simulation directory"
	@cp $(BOOTROM_HEX) $(BOOTROM_SIM_HEX)

# Create output directories if they do not exist
$(BOOTROM_OUT_DIR) $(BOOTROM_SIM_DIR):
	@mkdir -p $@

# Compile stage0 bootloader
$(BOOTROM_HEX):
	$(MAKE) -C $(TESTCODES_DIR)/$(BOOTLOADER) all_$(TOOL_CHAIN) $(SW_MAKE_OPTIONS)

# Target to remove bootrom build outputs
clean:
	@echo "Removing Bootrom Build Outputs"
	@rm -rf $(BOOTROM_OUT_DIR)
	@echo "Removing Bootrom Simulation Directory"
	@rm -rf $(BOOTROM_SIM_DIR)
