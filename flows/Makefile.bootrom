#-----------------------------------------------------------------------------
# NanoSoC Boot ROM Generation Makefile
# A joint work commissioned on behalf of SoC Labs, under Arm Academic Access license.
#
# Contributors
#
# David Mapstone (d.a.mapstone@soton.ac.uk)
#
# Copyright (C) 2026, SoC Labs (www.soclabs.org)
#-----------------------------------------------------------------------------
# Description:
# This Makefile generates the bootrom files for NanoSoC. This has been separated out
# of the software compilation makefile for simplicity.
#
# Outputs (all in build/firmware/gcc/stage0/out/):
#   stage0.hex       — Verilog hex file from GCC compilation
#   bootrom.sv       — Synthesizable Verilog ROM module
#   bootrom.bintxt   — Binary text representation
#-----------------------------------------------------------------------------

#------------------------------------------------------------------------
# Read the AutoConfig Overloaded Variables
#------------------------------------------------------------------------
include $(SOCLABS_PROJECT_DIR)/autoconfig
export TOOL_CHAIN

# Software make options
# - Pass onto the software makefile to define targetted CPU type
# You can append additional make options for testcode here
SW_MAKE_OPTIONS = CPU_PRODUCT=CORTEX_M0 TOOL_CHAIN=$(TOOL_CHAIN)

# The system clock the boot ROM is compiled for (FW_CLK_ARG, FW_CLK_STAMP). The
# same fragment as flows/makefile.software, so both images follow one value.
include $(SOCLABS_NANOSOC_ARCH_TECH_DIR)/flows/fw_clk.mk

# Bootrom Parameters:
# Stage 0 bootloader image
BOOTLOADER            ?= stage0
# Boot ROM size: phys bytes = 4 * 2^BOOTROM_ADDRW. The RTL carries the same
# quantity as BOOTROM_ADDR_W in the SoC's generated config package; a project
# sets BOOTROM_ADDRW in its nanosoc.config to track it (makefile.software
# passes it through). The origin is recorded before the default is applied so
# check_bootrom_addrw can tell "project said N" from "flow default".
BOOTROM_ADDRW_ORIGIN  := $(origin BOOTROM_ADDRW)
BOOTROM_ADDRW         ?= 8
BOOTROM_CONFIG_PKG    ?= $(SOCLABS_NANOSOC_SOC_DIR)/build_soc/rtl/nanosoc_soc_config_pkg.sv
BOOTROM_MODULE        ?= bootrom
BOOTROM_REGION_MODULE ?= nanosoc_region_bootrom
BOOTROM_OUT_DIR       ?= $(SOCLABS_PROJECT_DIR)/build/firmware/bootloader/$(BOOTLOADER)/out
BOOTROM_HEX           ?= $(BOOTROM_OUT_DIR)/$(BOOTLOADER).hex

# Boot ROM generation
#--------------------------------------------------------------------------------
# All outputs go next to the hex file in the firmware build directory
BOOTROM_SV         := $(BOOTROM_OUT_DIR)/$(BOOTROM_MODULE).sv
BOOTROM_BIN        := $(BOOTROM_OUT_DIR)/bootrom.bintxt
BOOTROM_REGION_SV  := $(BOOTROM_OUT_DIR)/$(BOOTROM_REGION_MODULE).v

BOOTROM_SIM_DIR := $(SIM_TOP_DIR)/bootloader
BOOTROM_SIM_HEX := $(BOOTROM_SIM_DIR)/$(BOOTLOADER).hex

# Tools
BOOTROM_GEN_PY := $(SOCLABS_NANOSOC_ARCH_TECH_DIR)/firmware/testcodes/bootloader/bootrom_gen.py
# The generator renders both outputs from these templates. They are real inputs,
# so they are real prerequisites: editing a template used to change nothing
# until the hex happened to be rebuilt.
BOOTROM_GEN_TEMPLATES := \
  $(wildcard $(SOCLABS_NANOSOC_ARCH_TECH_DIR)/firmware/testcodes/bootloader/bootrom_templ.sv.jinja) \
  $(wildcard $(SOCLABS_NANOSOC_ARCH_TECH_DIR)/firmware/testcodes/bootloader/bootrom_region_templ.v.jinja)

# Shared firmware the bootloader links against, plus the generated linker and
# memory-map fragments. Used as prerequisites of $(BOOTROM_HEX) below.
BOOTROM_FW_DIRS := $(TESTCODES_DIR)/$(BOOTLOADER) \
                   $(SOCLABS_NANOSOC_ARCH_TECH_DIR)/firmware/software \
                   $(SOCLABS_NANOSOC_ARCH_TECH_DIR)/firmware/build
BOOTROM_SRCS := $(shell find -L $(BOOTROM_FW_DIRS) -type f \( \
                   -name '*.c' -o -name '*.h' -o -name '*.s' -o -name '*.S' \
                   -o -name '*.ld' -o -name '*.mk' -o -iname 'makefile' \
                   -o -name '*.cmake' -o -name 'CMakeLists.txt' \) 2>/dev/null)
BOOTROM_SRCS += $(wildcard $(SOCLABS_NANOSOC_SOC_DIR)/build_soc/firmware/*.ld) \
                $(wildcard $(SOCLABS_NANOSOC_SOC_DIR)/build_soc/firmware/*.h) \
                $(wildcard $(SOCLABS_NANOSOC_SOC_DIR)/build_soc/firmware/*.mk)

# Post-generation guard. check_bootrom_addrw (below) compares the flow against
# the RTL config package BEFORE generation; this compares the generated files
# against each other and against the ROM_ADDR_W the SoC actually passes AFTER it.
#   HARD, always: the decode cannot reach every ROM word (the old byte-width
#     slice, or a ROM_ADDR_W override smaller than the ROM), or the generated
#     files disagree with each other.
#   SIZE, MEM_SIZE_CHECK (warn by default, error opt-in -- the same knob and
#     MEM_SIZE_WAIVE=BOOTROM waiver as check_mem_sizes): the ROM is smaller than
#     the region the SoC decodes or the linker script offers. The Academic Access
#     projects build a 1 KB ROM under an 8 KB region and linker script today;
#     that is named on every build and must not fail it.
# MEM_SIZE_CHECK/MEM_SIZE_WAIVE reach this standalone sub-make through the
# environment (flows/makefile.software exports them).
BOOTROM_REACH_CHECK := $(SOCLABS_NANOSOC_ARCH_TECH_DIR)/flows/checks/check_bootrom_reach.sh
BOOTROM_LD         ?= $(SOCLABS_NANOSOC_SOC_DIR)/build_soc/firmware/nanosoc_cmsdk_bootloader_memory.ld

.PHONY: bootrom check_bootrom_addrw check_bootrom_reach
bootrom: check_bootrom_addrw $(BOOTROM_SV) $(BOOTROM_BIN) $(BOOTROM_REGION_SV) $(BOOTROM_SIM_HEX) check_bootrom_reach

check_bootrom_reach: $(BOOTROM_SV) $(BOOTROM_REGION_SV)
	@$(BOOTROM_REACH_CHECK) --self-test >/dev/null
	@$(BOOTROM_REACH_CHECK) $(BOOTROM_SV) $(BOOTROM_REGION_SV) $(BOOTROM_ADDRW) $(BOOTROM_LD) $(BOOTROM_CONFIG_PKG)

# Fail when the project set BOOTROM_ADDRW to a value the RTL disagrees with.
# When the project did not set it (flow default in use) only warn: the default
# is shared by projects that size their ROM elsewhere, and the generated ROM
# still works when the image fits. No config package: nothing to compare.
check_bootrom_addrw:
	@if [ -f "$(BOOTROM_CONFIG_PKG)" ]; then \
	  rtl=$$(sed -nE '/BOOTROM_ADDR_W/{s/^[[:space:]]*localparam[[:space:]]+(int[[:space:]]+)?BOOTROM_ADDR_W[[:space:]]*=[[:space:]]*([0-9]+).*/\2/p;q;}' "$(BOOTROM_CONFIG_PKG)"); \
	  if [ -z "$$rtl" ]; then \
	    echo "WARNING: bootrom: no BOOTROM_ADDR_W found in $(BOOTROM_CONFIG_PKG); cannot check BOOTROM_ADDRW=$(BOOTROM_ADDRW)." >&2; \
	  elif [ "$$rtl" != "$(BOOTROM_ADDRW)" ]; then \
	    if [ "$(BOOTROM_ADDRW_ORIGIN)" = "undefined" ]; then \
	      echo "WARNING: bootrom: flow default BOOTROM_ADDRW=$(BOOTROM_ADDRW) ($$((4<<$(BOOTROM_ADDRW))) bytes) but the RTL has BOOTROM_ADDR_W=$$rtl ($$((4<<$$rtl)) bytes) in $(BOOTROM_CONFIG_PKG). Set 'BOOTROM_ADDRW := $$rtl' in nanosoc.config." >&2; \
	    else \
	      echo "ERROR: bootrom: BOOTROM_ADDRW=$(BOOTROM_ADDRW) ($$((4<<$(BOOTROM_ADDRW))) bytes, from $(BOOTROM_ADDRW_ORIGIN)) but the RTL has BOOTROM_ADDR_W=$$rtl ($$((4<<$$rtl)) bytes) in $(BOOTROM_CONFIG_PKG). Make them agree." >&2; \
	      exit 1; \
	    fi; \
	  fi; \
	fi

# Generate the Boot ROM Verilog, region wrapper, and Binary Text files from the bootloader hex file
$(BOOTROM_SV) $(BOOTROM_BIN) $(BOOTROM_REGION_SV): $(BOOTROM_HEX) $(BOOTROM_GEN_PY) $(BOOTROM_GEN_TEMPLATES) | $(BOOTROM_OUT_DIR)
	@echo "Generating Boot ROM Verilog, region wrapper, and Binary Text files"
	@echo "Toolchain: $(TOOL_CHAIN)"
	@python3 $(BOOTROM_GEN_PY) -a $(BOOTROM_ADDRW) -i $(BOOTROM_HEX) -t $(TOOL_CHAIN) \
		-m $(BOOTROM_MODULE) -v $(BOOTROM_SV) -b $(BOOTROM_BIN) \
		-R $(BOOTROM_REGION_MODULE) -r $(BOOTROM_REGION_SV)

# Copy the bootloader hex file to the simulation directory
$(BOOTROM_SIM_HEX): $(BOOTROM_HEX) | $(BOOTROM_SIM_DIR)
	@echo "Copying Boot ROM hex file to simulation directory"
	@cp $(BOOTROM_HEX) $(BOOTROM_SIM_HEX)

# Create output directories if they do not exist
$(BOOTROM_OUT_DIR) $(BOOTROM_SIM_DIR):
	@mkdir -p $@

# Compile stage0 bootloader
# Prerequisites, for the same reason as $(TESTCODE_HEX) in flows/makefile.software:
# with none at all this target could never be out of date, so an edited
# bootloader source was silently not rebuilt and the boot ROM kept the old image.
# FW_CLK_STAMP: a boot ROM built for another SYS_CLK_FREQ_HZ is stale (fw_clk.mk).
$(BOOTROM_HEX): $(BOOTROM_SRCS) $(FW_CLK_STAMP)
	$(MAKE) -C $(TESTCODES_DIR)/$(BOOTLOADER) all_$(TOOL_CHAIN) $(SW_MAKE_OPTIONS)$(FW_CLK_ARG)

# Target to remove bootrom build outputs
clean:
	@echo "Removing Bootrom Build Outputs"
	@rm -rf $(BOOTROM_OUT_DIR)
	@echo "Removing Bootrom Simulation Directory"
	@rm -rf $(BOOTROM_SIM_DIR)
