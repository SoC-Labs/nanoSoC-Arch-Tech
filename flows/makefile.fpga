# Get properties for FPGA Boards
include $(SOCLABS_NANOSOC_ARCH_TECH_DIR)/fpga/fpga/makefile.targets

# Vivado Options
VIVIADO_VERSION  ?= 2021_1

# NanoSoC Synthesis Properties
NANOSOC_VENDOR   ?= soclabs.org
NANOSOC_CORE_REV ?= 2

# Top-level of RTL design to Implement
COMPONENT_TOP    ?= nanosoc_chip

# Name of Implemented Chip Design (Including Socket IP)
DESIGN_NAME      ?= nanosoc_design

# Location to build FPGA files
IMPLEMENTATION_DIR   ?= $(SOCLABS_PROJECT_DIR)/imp/fpga
RUN_DIR              := $(IMPLEMENTATION_DIR)/run
IMP_NANOSOC_DIR      := $(IMPLEMENTATION_DIR)/nanosoc
IMP_SOCKET_DIR       := $(IMPLEMENTATION_DIR)/socket
PROJECT_DIR          := $(IMPLEMENTATION_DIR)/targets/$(BOARD_NAME)

# Location of Defines File
DEFINES_DIR          := $(SOCLABS_PROJECT_DIR)/system/src/defines/
DEFINES_FILE         := $(DEFINES_DIR)/gen_defines.v

# Name of generated filelist by python script
TCL_FLIST_DIR        := $(IMP_NANOSOC_DIR)/flist
TCL_OUTPUT_FILELIST  := $(TCL_FLIST_DIR)/gen_flist.tcl
GENUS_OUTPUT_FILELIST := $(TCL_FLIST_DIR)/genus_flist.tcl

# NanoSoC Tech Flow Dependencies
NANOSOC_FPGA_FLOW_DIR := $(SOCLABS_NANOSOC_ARCH_TECH_DIR)/fpga/fpga

# Directory to look for FPGA specific implementation files
TARGET_DIR            ?= $(NANOSOC_FPGA_FLOW_DIR)/targets/$(BOARD_NAME)
TARGET_TCL_DIR        := $(TARGET_DIR)/vivado_script/$(VIVIADO_VERSION)
PINMAP_FILE           ?= $(TARGET_DIR)/fpga_pinmap.xdc

# NanoSoC Tech Socket Design Dependencies
RTL_SOCKET_DIR        := $(SOCLABS_SOCDEBUG_TECH_DIR)/socket/vivado_packages

# Define Bitfile Output Directory depending on Platform
ifeq ($(PLATFORM), bare)
	OUTPUT_DIR ?=  $(IMPLEMENTATION_DIR)/output/$(BOARD_NAME)
else ifeq ($(PLATFORM), pynq)
	OUTPUT_DIR ?=  $(IMPLEMENTATION_DIR)/output/$(BOARD_NAME)/overlays
endif

# Compile Testcodes and Bootrom
# - This duplicates the recipe within makefile.software
# code:
# 	@echo Compiling Firmware
# 	@$(MAKE) -C $(SOCLABS_NANOSOC_ARCH_TECH_DIR) bootrom

#------------------------------------------------------------------------------
# RAM_PRELOAD for the FPGA flow
#------------------------------------------------------------------------------
# On hardware IMEM has to come up holding an image, which is exactly what
# RAM_PRELOAD selects in rtl/src/regions/imem/nanosoc_region_imem.v. Until now
# RAM_PRELOAD existed only as a target-specific variable on the simulation
# compile targets, so an FPGA build wrote a defines file containing nothing but
# FAST_SIM and the bitstream came out with a plain SRAM. Nothing said so.
#
# The define has to travel in the generated defines FILE, not on a command line:
# the SoC is packaged with ipx::package_project and a fileset +define+ is
# dropped by packaging. fpga/fpga/vivado_ip/nanosoc_chip_vivado_wrapper.v:21
# `include "gen_defines.v", which is why writing it there reaches the packaged
# IP. RAM_PRELOAD is therefore attached to the FPGA flow's goals, the same way
# makefile.simulate attaches it to the simulation flow's goals, so the defines
# file is the same whichever goal in this flow runs.
#
# Default no, because that is what the Academic Access FPGA builds produce
# today and this must not change their bitstreams. A project that wants a
# preloaded IMEM sets FPGA_RAM_PRELOAD := yes in its nanosoc.config.
#
# RAM_PRELOAD ALONE IS NOT ENOUGH ON AN FPGA. It selects sl_ahb_rom, and
# fpga_lib_tech's sl_ahb_rom loads its image through Arm's cmsdk_fpga_rom,
# whose initial-block copy loop Vivado drops (Synth 8-311): the BRAM comes up
# ZERO and nothing fails. RAM_PRELOAD_WORD (fpga_lib_tech fix/rom-preload)
# selects sl_fpga_rom_word instead, which Vivado initialises from a WORD-format
# hex. It is added here and never by the simulation flow, which also defines
# RAM_PRELOAD and hands the ROM a BYTE-format image.hex.
FPGA_RAM_PRELOAD ?= no

# Absolute path to the word-format hex $readmemh should preload. Empty by
# default. When set, gen_defs (the defines file's only writer, see makefile)
# adds `define IMEM_FPGA_IMAGE "<path>" for this flow's goals, and
# nanosoc_region_imem.v uses it in place of the
# MEM_FPGA_IMG parameter. That exists because the generated chip does not pass
# IMEM_MEM_FPGA_IMG down from the top, and the alternative -- editing a path
# into generated RTL -- works once and is not a mechanism.
IMEM_FPGA_IMAGE ?=

# flist_tcl_nanosoc is the ONLY goal in this flow that reaches gen_defs, and a
# target-specific variable is inherited by prerequisites, so listing it here
# covers build_fpga and both package_* goals. Listing those as well would append
# RAM_PRELOAD once per level of the chain.
FPGA_FLOW_DEFINES_TARGETS := flist_tcl_nanosoc
ifeq ($(FPGA_RAM_PRELOAD),yes)
$(FPGA_FLOW_DEFINES_TARGETS): NANOSOC_DEFINES += RAM_PRELOAD RAM_PRELOAD_WORD
endif
$(FPGA_FLOW_DEFINES_TARGETS): NANOSOC_DEFINE_IMEM_IMAGE = $(IMEM_FPGA_IMAGE)

# Generate TCL filelist from flists
flist_tcl_nanosoc: gen_defs
	@mkdir -p $(TCL_FLIST_DIR)
	@(cd $(TCL_FLIST_DIR); \
	$(SOCLABS_SOCTOOLS_FLOW_DIR)/bin/filelist_compile.py -t -f $(DESIGN_VC_FPGA) -o $(TCL_OUTPUT_FILELIST) -i $(FLIST_INCLUDES) -r $(IMP_NANOSOC_DIR)/src -d $(NANOSOC_DEFINES);)

# Package NanoSoC Socket Components
package_socket:
	@$(MAKE) -C $(SOCLABS_SOCDEBUG_TECH_DIR)/fpga package_socket IMP_SOCKET_DIR=$(IMP_SOCKET_DIR) RTL_SOCKET_DIR=$(RTL_SOCKET_DIR)

# Environment Variables for Packaging NanoSoC
package_nanosoc: export FPGA_COMPONENT_FILELIST = $(TCL_OUTPUT_FILELIST)
package_nanosoc: export FPGA_COMPONENT_LIB      = $(IMP_NANOSOC_DIR)
package_nanosoc: export FPGA_ACCELERATOR        = $(ACCELERATOR_SUBSYSTEM)
package_nanosoc: export FPGA_COMPONENT_TOP      = $(COMPONENT_TOP)
package_nanosoc: export FPGA_VENDOR             = $(NANOSOC_VENDOR)
package_nanosoc: export FPGA_CORE_REV           = $(NANOSOC_CORE_REV)

# Package NanoSoC IP
package_nanosoc: code flist_tcl_nanosoc
	@echo Packaging NanoSoC
	@mkdir -p $(RUN_DIR)
	@cd $(RUN_DIR); vivado -mode batch -source $(SOCLABS_SOCTOOLS_FLOW_DIR)/resources/fpga/package_component.tcl
	@mkdir -p $(IMP_NANOSOC_DIR)/logs
	@cp $(RUN_DIR)/vivado.log $(IMP_NANOSOC_DIR)/logs
	@echo NanoSoC Packaged

# Vivado IP Wrapper Directory
VIVADO_IP_DIR            := $(SOCLABS_NANOSOC_ARCH_TECH_DIR)/fpga/fpga/vivado_ip
IMP_NANOSOC_IP_DIR       := $(IMPLEMENTATION_DIR)/nanosoc_ip

# Environment Variables for Packaging NanoSoC as Vivado IP (with bus interfaces)
package_nanosoc_ip: export FPGA_COMPONENT_FILELIST = $(TCL_OUTPUT_FILELIST)
package_nanosoc_ip: export FPGA_COMPONENT_LIB      = $(IMP_NANOSOC_IP_DIR)
package_nanosoc_ip: export FPGA_VENDOR             = $(NANOSOC_VENDOR)
package_nanosoc_ip: export FPGA_CORE_REV           = $(NANOSOC_CORE_REV)

# Package NanoSoC as a Vivado drop-in IP with proper bus interfaces
package_nanosoc_ip: code flist_tcl_nanosoc
	@echo Packaging NanoSoC as Vivado IP
	@mkdir -p $(RUN_DIR)
	@cd $(RUN_DIR); vivado -mode batch -source $(VIVADO_IP_DIR)/package_nanosoc_ip.tcl
	@mkdir -p $(IMP_NANOSOC_IP_DIR)/logs
	@cp $(RUN_DIR)/vivado.log $(IMP_NANOSOC_IP_DIR)/logs
	@echo NanoSoC Vivado IP Packaged at $(IMP_NANOSOC_IP_DIR)

# Environment Variables for Build NanoSoC Design
build_nanosoc_design: export FPGA_NAME               = $(BOARD_NAME)
build_nanosoc_design: export FPGA_PART               = $(XILINX_PART)
build_nanosoc_design: export FPGA_PROJECT_DIR        = $(PROJECT_DIR)
build_nanosoc_design: export FPGA_TARGET             = $(TARGET_DIR)
build_nanosoc_design: export FPGA_TARGET_TCL         = $(TARGET_TCL_DIR)
build_nanosoc_design: export FPGA_DESIGN_NAME        = $(DESIGN_NAME)
build_nanosoc_design: export FPGA_WRAPPER_NAME       = $(DESIGN_NAME)_wrapper
build_nanosoc_design: export FPGA_OUTPUT_DIR         = $(OUTPUT_DIR)
build_nanosoc_design: export FPGA_PINMAP             = $(PINMAP_FILE)
build_nanosoc_design: export FPGA_IMP_DIR            = $(IMPLEMENTATION_DIR)

# Synthesise and Implement an FPGA Bitfile
build_nanosoc_design:
	@echo Building NanoSoC Design
	@mkdir -p $(RUN_DIR)
	@cd $(RUN_DIR); vivado -mode batch -source $(SOCLABS_SOCTOOLS_FLOW_DIR)/resources/fpga/build_design.tcl
	@cp $(RUN_DIR)/vivado.log $(TARGET_DIR)
	@echo Built NanoSoC Design

# Move Output Files 
output_nanosoc_design:
	@echo Moving NanoSoC Design Files
	@unzip -u -o $(PROJECT_DIR)/$(DESIGN_NAME).xsa -d $(PROJECT_DIR)/export
	@mkdir -p $(OUTPUT_DIR)
	@cp -p $(PROJECT_DIR)/export/$(DESIGN_NAME).bit $(OUTPUT_DIR)
	@cp -p $(PROJECT_DIR)/export/$(DESIGN_NAME).hwh $(OUTPUT_DIR)
	
# Build NanoSoC Design Flow
build_fpga: clean_fpga package_socket package_nanosoc build_nanosoc_design output_nanosoc_design
	@echo NanoSOC Design Complete

# Clean FPGA Run
clean_fpga:
	@echo Cleaning Previous Runs of $(BOARD_NAME)
	@rm -rf $(PROJECT_DIR)
	@rm -rf $(RUN_DIR)

# Clean ALL FPGA Implementation Directory
clean_fpga_all:
	@echo Cleaning FPGA Implementation Directory
	@rm -rf $(IMPLEMENTATION_DIR)
	@echo Cleaning Firmware
	@$(MAKE) -C $(SOCLABS_NANOSOC_ARCH_TECH_DIR) clean_all_code