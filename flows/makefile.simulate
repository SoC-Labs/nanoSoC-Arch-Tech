# ADP command File
DEFAULT_ADP_FILE  = $(SIM_DIR)/adp.cmd
ADP_FILE         ?= $(DEFAULT_ADP_FILE)
ADP_OPTIONS      := -define ADP_FILE=\"$(ADP_FILE)\"

# MTI options
MTI_VC_OPTIONS    = +acc
MTI_VC_OPTIONS    += -suppress 2892
MTI_VC_OPTIONS    += -f $(TBENCH_VC) $(ADP_OPTIONS)

MTI_RUN_OPTIONS   = -voptargs=+acc

# VCS options
VCS_OPTIONS    =  +vcs+lic+wait +v2k -sverilog -xprop=tmerge -override_timescale=1ns/1ps +lint=all,noTMR,noVCDE -debug -debug_access+all -kdb
VCS_SIM_OPTION = +vcs+lic+wait +vcs+flush+log -assert nopostproc
VCS_VC_OPTIONS = -f $(TBENCH_VC) $(ADP_OPTIONS)

ifeq ($(GATE), yes)
	VCS_OPTIONS += +no_notifier +notimingcheck +define+ARM_UD_MODEL +define+INITIALISE_MEMORY
	VCS_SIM_OPTION += +define+ARM_UD_MODEL +define+INITIALISE_MEMORY
endif

ifdef AMS
	VCS_OPTIONS += -ad=$(SOCLABS_NANOSOC_ARCH_TECH_DIR)/rtl/sl_ams_tech/vcsAD.init -ams_discipline logic  -ams
endif

# XM verilog options
XMSIM_OPTIONS  = -unbuffered -64bit -status -LICQUEUE -f xmsim.args -cdslib cds.lib -hdlvar hdl.var -NBASYNC
XM_VC_OPTIONS  = -f $(TBENCH_VC) $(ADP_OPTIONS) 

# Icarus Verilog options
IVERILOG_OPTIONS = -g2005-sv -DVCD_SIM
DEFINES_VC_IVERILOG=$(subst +define+, -D, $(DEFINES_VC))


# ------- Cocotb Variables -----------
# Convert Simulator Name for Cocotb
COCOTB_SIMULATOR ?= questa

ifeq ($(SIMULATOR),mti)
	COCOTB_SIMULATOR := questa
else ifeq ($(SIMULATOR),xm)
	COCOTB_SIMULATOR := xcelium
else ifeq ($(SIMULATOR),vcs)
	COCOTB_SIMULATOR := vcs
endif

ifeq ($(VCD_SIM),yes)
	NANOSOC_DEFINES += VCD_SIM
endif

# Cocotb GUI Variable
GUI ?= 0

# Cocotb Test Location
COCOTB_TEST_DIR := $(SOCLABS_NANOSOC_ARCH_TECH_DIR)/verification/cocotb

# Cocotb Scratch Directory
COCOTB_DIR := $(SIM_TOP_DIR)/cocotb
COCOTB_SCRATCH_DIR := $(COCOTB_DIR)/scratch

# Filelist for Cocotb 
MAKEFILE_FILELIST     := $(COCOTB_DIR)/makefile.flist

MODULE ?= test_adp

# Create a List of PHONY Targets
.PHONY: compile_$(SIMULATOR) run_$(SIMULATOR) sim_$(SIMULATOR) sim_gui_$(SIMULATOR)
.PHONY: compile run sim sim_gui

# ------- Simulator redirect -----------

compile: compile_$(SIMULATOR)

run: run_$(SIMULATOR)

# sim = compile + headless run in the foreground; its exit code is the run's.
# The interactive (GUI) session that 'sim' used to launch in the background
# is 'sim_gui'. A backgrounded GUI returned 0 whatever the compile did.
sim: sim_$(SIMULATOR)

sim_gui: sim_gui_$(SIMULATOR)

# Optional pass/fail gate on the run log, using the regression convention
# (makefile.regression: ' TEST PASSED ' / ' TEST SKIPPED ', else failed).
# Off by default so a test that does not print the marker keeps today's
# behaviour: run_* returns the simulator's exit code only.
#   make run SIM_CHECK_PASS=yes
SIM_CHECK_PASS ?= no
define check_sim_log
	@if [ "$(SIM_CHECK_PASS)" = "yes" ]; then \
	  if grep -q " TEST PASSED " $(1); then echo "run_$(TESTNAME): TEST PASSED ($(1))"; \
	  elif grep -q " TEST SKIPPED " $(1); then echo "run_$(TESTNAME): TEST SKIPPED ($(1))"; \
	  else echo "run_$(TESTNAME): FAILED - no ' TEST PASSED ' in $(1)" >&2; exit 1; fi; \
	fi
endef

# Preload IMEM in Simulation
#
# RAM_PRELOAD is a property of the SIMULATION flow, not of the compile step:
# the simulation image is loaded into IMEM from a hex file, which is what makes
# nanosoc_region_imem instantiate sl_ahb_rom instead of sl_ahb_sram. It used to
# be attached to the compile_* targets only, while flist_vfiles_nanosoc and
# flist_makefile_nanosoc -- the other two goals in this flow that write the
# shared defines file through gen_defs -- carried no such variable. Running a
# simulation flist goal and a compile goal in one make invocation therefore
# left the design without RAM_PRELOAD and compiled it without a word: a
# 121-module, 1,016,920-byte simv whose core stops inside the boot ROM.
#
# Listing every goal in this flow here is what makes the defines file the same
# whichever simulation goal runs. It is deliberately NOT a file-scope
# `NANOSOC_DEFINES += RAM_PRELOAD`: makefile.simulate is included for every
# goal, so a file-scope append would put RAM_PRELOAD into the FPGA and ASIC
# flists as well and change what those flows build for every consumer.
# flist_makefile_nanosoc (the cocotb filelist) is deliberately NOT in this list.
# Its bench uploads the image over ADP, so RAM_PRELOAD -- which swaps IMEM's
# sl_ahb_sram for a read-only sl_ahb_rom -- would change what that flow builds
# for every consumer. Mixing it with a compile goal in one make invocation is
# caught by check_defs instead of being silently allowed.
SIM_FLOW_DEFINES_TARGETS := compile_mti compile_vcs compile_xm compile_iverilog \
                            flist_vfiles_nanosoc
$(SIM_FLOW_DEFINES_TARGETS): NANOSOC_DEFINES += RAM_PRELOAD


# Generate verilog .vc filelist from flists
flist_vfiles_nanosoc: gen_defs
	@if [ ! -d $(SIM_DIR) ] ; then \
	  mkdir -p $(SIM_DIR); \
	fi
	@if [ ! -d $(SIM_DIR)/logs ] ; then \
	  mkdir -p $(SIM_DIR)/logs; \
	fi
	@cd $(SIM_DIR); python $(SOCLABS_SOCTOOLS_FLOW_DIR)/bin/filelist_compile.py -f $(TBENCH_VC) -a -i $(FLIST_INCLUDES) -v -o tbench.vc


# ------- VCS -----------

# Compile RTL
compile_vcs : gen_defs flist_vfiles_nanosoc check_defs
	cd $(SIM_DIR); vcs $(VCS_OPTIONS) -f tbench.vc  $(DEFINES_VC)  | tee compile_vcs.log


# Run simulation in batch mode (exit code is simv's; see SHELL/pipefail in makefile)
run_vcs : code compile_vcs
	@echo quit > $(SIM_DIR)/quit.do
	cd $(SIM_DIR); ./simv $(VCS_SIM_OPTION) -define ADP_FILE=adp.cmd < quit.do | tee logs/run_$(TESTNAME).log ;
	$(call check_sim_log,$(SIM_DIR)/logs/run_$(TESTNAME).log)

# Headless simulation in the foreground; exit code is the run's
sim_vcs : run_vcs

# Run simulation in interactive mode (backgrounded GUI; exit code says nothing about the run)
sim_gui_vcs : code compile_vcs
	cd $(SIM_DIR); ./simv -gui +vcs+lic+wait +vcs+flush+log &

# ------- XM -----------

# Compile RTL
compile_xm : bootrom gen_defs flist_vfiles_nanosoc check_defs
	@echo ADP_FILE
	@echo $(ADP_OPTIONS)
	cd $(SIM_DIR); xmprep  +overwrite $(XM_VC_OPTIONS) $(DEFINES_VC) +debug -timescale 1ns/1ps -top $(TB_TOP) | tee compile_xm.log
	cd $(SIM_DIR); xmvlog  -work worklib -f xmvlog_ver.args | tee -a compile_xm.log
	cd $(SIM_DIR); xmelab  -mess -f xmelab.args -access +r | tee -a compile_xm.log
	
# Note : If coverage is required, you can add -coverage all to xmelab

# Run simulation in batch mode
run_xm : code compile_xm
	@echo run  >  $(SIM_DIR)/run.tcl.tmp
	@echo exit >> $(SIM_DIR)/run.tcl.tmp
	@mv  $(SIM_DIR)/run.tcl.tmp $(SIM_DIR)/run.tcl
	cd $(SIM_DIR); xmsim $(XMSIM_OPTIONS) -input run.tcl  | tee logs/run_$(TESTNAME).log ;
	$(call check_sim_log,$(SIM_DIR)/logs/run_$(TESTNAME).log)

# Headless simulation in the foreground; exit code is the run's
sim_xm : run_xm

# Run simulation in interactive mode
sim_gui_xm : code compile_xm
	cd $(SIM_DIR); xmsim -gui $(XMSIM_OPTIONS)

# ------- MTI -----------

# Compile RTL
compile_mti : bootrom gen_defs flist_vfiles_nanosoc lib_mti check_defs
	cd $(SIM_DIR); vlog -incr -lint +v2k -f tbench.vc $(ADP_OPTIONS) $(DEFINES_VC) | tee compile_mti.log

# Run simulation in batch mode
# run_mti : code
run_mti : code compile_mti
	@echo "run -all" > $(SIM_DIR)/run.tcl.tmp
	@echo "quit -f" >> $(SIM_DIR)/run.tcl.tmp
	@mv  $(SIM_DIR)/run.tcl.tmp $(SIM_DIR)/run.tcl
	cd $(SIM_DIR); vsim $(MTI_RUN_OPTIONS) -c $(TB_TOP) -do run.tcl | tee $(SIM_DIR)/logs/run_$(TESTNAME).log ;
	$(call check_sim_log,$(SIM_DIR)/logs/run_$(TESTNAME).log)

run_mti_to:
	timeout 2s $(MAKE) run_mti >> /dev/null 2>&1 
	
run_mti_wrap:
	$(MAKE) run_mti_to
	
# Headless simulation in the foreground; exit code is the run's
sim_mti : run_mti

# Run simulation in interactive mode (backgrounded GUI; exit code says nothing about the run)
sim_gui_mti : code compile_mti
	cd $(SIM_DIR); vsim $(MTI_RUN_OPTIONS) -gui $(TB_TOP) &

# Create work directory
lib_mti :
	@if [ -d $(SIM_DIR)/work ] ; then \
          true ; \
	else \
	  vlib  $(SIM_DIR)/work; \
	fi

# ------- Icarus -----------

# Compile RTL
compile_iverilog: bootrom gen_defs flist_vfiles_nanosoc check_defs
	cd $(SIM_DIR); iverilog $(IVERILOG_OPTIONS) $(DEFINES_VC_IVERILOG) -o nanosoc_chip_pads -c tbench.vc

run_iverilog: code compile_iverilog
	cd $(SIM_DIR); vvp -l $(SIM_DIR)/logs/run_$(TESTNAME).log nanosoc_chip_pads;
	$(call check_sim_log,$(SIM_DIR)/logs/run_$(TESTNAME).log)

# Headless simulation in the foreground; exit code is the run's
sim_iverilog: run_iverilog

# Run, then open the waveform viewer
sim_gui_iverilog: run_iverilog
	cd $(SIM_DIR); gtkwave waves.vcd

# Generate Make filelist from flists
flist_makefile_nanosoc: gen_defs
	@mkdir -p $(COCOTB_DIR)
	@(cd $(COCOTB_DIR); \
	$(SOCLABS_SOCTOOLS_FLOW_DIR)/bin/filelist_compile.py -m -f $(DESIGN_VC) -i $(FLIST_INCLUDES) -o $(MAKEFILE_FILELIST);)

run_cocotb: DEFINES_VC += COCOTB_SIM
run_cocotb: flist_makefile_nanosoc
	@mkdir -p $(SIM_DIR)
	@cd $(SIM_DIR); $(MAKE) -C $(SOCLABS_NANOSOC_ARCH_TECH_DIR)/verification/cocotb clean SIM_BUILD=$(COCOTB_SCRATCH_DIR)
	@cd $(SIM_DIR); $(MAKE) -C $(SOCLABS_NANOSOC_ARCH_TECH_DIR)/verification/cocotb sim MODULE=$(MODULE) SIM=$(COCOTB_SIMULATOR) TESTCASE=$(TESTNAME) GUI=$(GUI) SIM_BUILD=$(COCOTB_SCRATCH_DIR) ACCELERATOR=$(ACCELERATOR)

sim_cocotb: GUI=1
sim_cocotb: run_cocotb

# Run region probe cocotb test (read + write-read accessibility check via ADP)
run_cocotb_region_probe: COCOTB_SIMULATOR := vcs
run_cocotb_region_probe: MODULE := test_region_probe
run_cocotb_region_probe: run_cocotb
