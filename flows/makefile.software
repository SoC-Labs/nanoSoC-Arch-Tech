# Software Directory
NANOSOC_SW_DIR     ?= $(SOCLABS_NANOSOC_ARCH_TECH_DIR)/firmware/software

# Software make options
# - Pass onto the software makefile to define targetted CPU type
# You can append additional make options for testcode here
SW_MAKE_OPTIONS = CPU_PRODUCT=CORTEX_M0 TOOL_CHAIN=$(TOOL_CHAIN)

# Debug Tester image
DEBUGTESTER  = debugtester

# Stage 0 bootloader name
BOOTLOADER  ?= stage0

# Firmware config — pre-generated linker script fragments and address map headers
# located in build_soc/firmware (generated by the SoC interconnect build).
FIRMWARE_CONFIG_DIR   ?= $(SOCLABS_NANOSOC_SOC_DIR)/build_soc/firmware

firmware_config:
	@test -f $(FIRMWARE_CONFIG_DIR)/nanosoc_memmap.h || \
		{ echo "ERROR: firmware config not found in $(FIRMWARE_CONFIG_DIR)"; exit 1; }

# code target is used by other simulation targets (e.g. run_mti, sim_mti)
# Before simulation, bootrom and testcode need to be compiled.
# firmware_config must be generated first (provides linker memory fragments).
code: firmware_config bootrom testcode debugtester

NANOSOC_TESTCODES_DIR := $(SOCLABS_NANOSOC_ARCH_TECH_DIR)/firmware/testcodes

# Bootloader source directory — use SoC-level firmware if it exists (QSPI-aware),
# otherwise fall back to arch_tech-level bootloader.
NANOSOC_SOC_STAGE0_DIR := $(SOCLABS_NANOSOC_SOC_DIR)/firmware/bootloader/stage0
ifneq ($(wildcard $(NANOSOC_SOC_STAGE0_DIR)/makefile),)
    BOOTLOADER_TESTCODES_DIR := $(SOCLABS_NANOSOC_SOC_DIR)/firmware/bootloader
else
    BOOTLOADER_TESTCODES_DIR := $(NANOSOC_TESTCODES_DIR)
endif

# Run the bootrom flow from the other makefile.
# Makefile.bootrom is a standalone makefile (it never includes this chain), so
# a project's BOOTROM_ADDRW (nanosoc.config) is passed on its command line
# whenever it is set; unset, the flow default in Makefile.bootrom applies and
# the command line is exactly what it was.
BOOTROM_ADDRW_ARG = $(if $(BOOTROM_ADDRW), BOOTROM_ADDRW=$(BOOTROM_ADDRW))

bootrom:
	@$(MAKE) -f $(SOCLABS_NANOSOC_ARCH_TECH_DIR)/flows/Makefile.bootrom bootrom \
		SIM_TOP_DIR=$(SIM_TOP_DIR) \
		TESTCODES_DIR=$(BOOTLOADER_TESTCODES_DIR)$(BOOTROM_ADDRW_ARG)

# Compare the flow's BOOTROM_ADDRW with the RTL's BOOTROM_ADDR_W (also a
# prerequisite of bootrom; see Makefile.bootrom)
check_bootrom_addrw:
	@$(MAKE) -f $(SOCLABS_NANOSOC_ARCH_TECH_DIR)/flows/Makefile.bootrom check_bootrom_addrw \
		SIM_TOP_DIR=$(SIM_TOP_DIR) \
		TESTCODES_DIR=$(BOOTLOADER_TESTCODES_DIR)$(BOOTROM_ADDRW_ARG)

# Compile test code
# Note : The use of ls after compile allows the computing server to sync up
TEST_BUILD_DIR := $(SOCLABS_PROJECT_DIR)/build/firmware
# Namespaced: this file is included before flows/makefile.fpga, whose
# 'OUTPUT_DIR ?=' (the bitstream directory) was silently overridden by an
# unnamespaced ':=' here, so build_fpga wrote the .bit under build/firmware/.
SW_OUTPUT_DIR := $(TEST_BUILD_DIR)/$(TESTNAME)/out

# Check if the there is a directory in the nanosoc testcodes directory for a test
# - if not test TESTCODES_DIR to that of the porject software directory
ifneq ($(wildcard $(NANOSOC_TESTCODES_DIR)/$(TESTNAME)),)
    TESTCODES_DIR := $(NANOSOC_TESTCODES_DIR)
else
    TESTCODES_DIR := $(PROJ_SW_DIR)
endif

# Testcode hex is built into the project-level build directory
TESTCODE_HEX := $(SW_OUTPUT_DIR)/$(TESTNAME).hex

# image.hex in the sim dir is what the IMEM reads at simulation time
IMAGE_HEX := $(SIM_DIR)/image.hex

$(TESTCODE_HEX):
	@$(MAKE) -C $(TESTCODES_DIR)/$(TESTNAME) all $(SW_MAKE_OPTIONS)

$(IMAGE_HEX): $(TESTCODE_HEX) | $(SIM_DIR)
	@cp $(TESTCODE_HEX) $(IMAGE_HEX)

$(SIM_DIR):
	@mkdir -p $@

# ADP File
ADP_FILE   := $(SIM_DIR)/adp.cmd
ADP_SOURCE := $(TESTCODES_DIR)/$(TESTNAME)/adp.cmd

$(ADP_FILE): | $(SIM_DIR)
	@if [ -e $(ADP_SOURCE) ]; then \
	  cp $(ADP_SOURCE) $(ADP_FILE); \
	else \
	  echo "# Default empty ADP command file" > $(ADP_FILE); \
	fi

# Copy DATA CSV
DATA_CSV := $(SIM_DIR)/data_in.csv
DATA_CSV_SOURCE := $(TESTCODES_DIR)/$(TESTNAME)/data_in.csv

$(DATA_CSV): $(DATA_CSV_SOURCE) | $(SIM_DIR)
	@cp $(DATA_CSV_SOURCE) $(DATA_CSV)

# Only create DATA_CSV target if source file exists
ifneq ($(wildcard $(DATA_CSV_SOURCE)),)
    OPTIONAL_TESTCODE_DEPS += $(DATA_CSV)
else
    OPTIONAL_TESTCODE_DEPS +=
endif

# Only copy expram files if they exist
SRAM_0 := $(SIM_DIR)/sram_0.hex
SRAM_0_SOURCE := $(TESTCODES_DIR)/$(TESTNAME)/sram_0.hex
$(SRAM_0): $(SRAM_0_SOURCE) | $(SIM_DIR)
	@cp $(SRAM_0_SOURCE) $(SRAM_0)
SRAM_1 := $(SIM_DIR)/sram_1.hex
SRAM_1_SOURCE := $(TESTCODES_DIR)/$(TESTNAME)/sram_1.hex

$(SRAM_1): $(SRAM_1_SOURCE) | $(SIM_DIR)
	@cp $(SRAM_1_SOURCE) $(SRAM_1)

ifneq ($(wildcard $(SRAM_0_SOURCE)),)
    OPTIONAL_TESTCODE_DEPS += $(SRAM_0)
endif

ifneq ($(wildcard $(SRAM_1_SOURCE)),)
    OPTIONAL_TESTCODE_DEPS += $(SRAM_1)
endif

testcode: $(IMAGE_HEX) $(ADP_FILE) $(OPTIONAL_TESTCODE_DEPS) $(SIM_DIR)


# Compile debugtester
# Note : The use of ls after compile allows the computing server to sync up
DEBUGTESTER_BUILD_DIR := $(SOCLABS_PROJECT_DIR)/build/firmware
DEBUGTESTER_OUTPUT_DIR := $(DEBUGTESTER_BUILD_DIR)/$(DEBUGTESTER)/out

# Location of the Hex files that are built for debugtester
DEBUGTESTER_LE_HEX := $(DEBUGTESTER_OUTPUT_DIR)/$(DEBUGTESTER)_le.hex
DEBUGTESTER_BE_HEX := $(DEBUGTESTER_OUTPUT_DIR)/$(DEBUGTESTER)_be.hex

$(DEBUGTESTER_LE_HEX) $(DEBUGTESTER_BE_HEX):
	@$(MAKE) -C $(NANOSOC_SW_DIR)/debug_tester all $(SW_MAKE_OPTIONS)

# Copy debugtester little-endian hex to SIM_DIR
DEBUGTESTER_LE_SIM := $(SIM_DIR)/$(DEBUGTESTER)_le.hex
$(DEBUGTESTER_LE_SIM): $(DEBUGTESTER_LE_HEX) | $(SIM_DIR)
	@cp $(DEBUGTESTER_LE_HEX) $(DEBUGTESTER_LE_SIM)

# Copy debugtester big-endian hex to SIM_DIR
DEBUGTESTER_BE_SIM := $(SIM_DIR)/$(DEBUGTESTER)_be.hex
$(DEBUGTESTER_BE_SIM): $(DEBUGTESTER_BE_HEX) | $(SIM_DIR)
	@cp $(DEBUGTESTER_BE_HEX) $(DEBUGTESTER_BE_SIM)

debugtester: $(DEBUGTESTER_LE_SIM) $(DEBUGTESTER_BE_SIM)

# Compile all software including boot ROM
compile_all_code: bootrom debugtester
	for thistest in $(TEST_LIST) ; do \
	  echo Compiling $$thistest   ; \
	  echo Removing old image.hex ;\
	  rm -f image.hex  ;\
	  $(MAKE) testcode TESTNAME=$$thistest;\
	  if [ -e $(SIM_TOP_DIR)/$$thistest/image.hex ] ; then \
            echo OK    - image.hex     created for test $$thistest ;\
	  else \
	    echo ERROR - image.hex NOT created for test $$thistest ;\
	    exit 1; \
	  fi ; \
	done

# Remove all firmware compilation results
clean_all_code:
	@rm -rf $(SOCLABS_PROJECT_DIR)/build/firmware
	@$(MAKE) -f $(SOCLABS_NANOSOC_ARCH_TECH_DIR)/flows/Makefile.bootrom clean

# Remove only stage0 bootloader and default selected test
clean_code:
	@rm -rf $(SOCLABS_PROJECT_DIR)/build/firmware/bootloader
	@rm -rf $(SOCLABS_PROJECT_DIR)/build/firmware/$(TESTNAME)
