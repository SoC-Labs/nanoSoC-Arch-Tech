//-----------------------------------------------------------------------------
// Abstract : Verilog Command File for NanoSoC IP
//-----------------------------------------------------------------------------

// ============= Verilog library extensions ===========
+libext+.v+.vlib

// =============    NanoSoC IP search path    =============

// NanoSoC Chip Level (in nanosoc_m0_soc)
// NANOSOC_CHIP_DIR is set in the nanosoc_arch_tech makefile and defaults to the
// checked-in chip/chip/verilog, so this list resolves exactly as it always has
// for a project that does not set it.
// A project overrides it (and NANOSOC_CHIP_PADS_DIR in nanosoc.flist) in its
// nanosoc.config when the checked-in chip no longer matches its nanosoc_system.
// The checked-in chip carries four SPI ports (spi_sclk_o, spi_ss_o, spi_mosi_o,
// spi_miso_i) and passes them to nanosoc_system; a project that has removed SPI
// from its system gets 4 x UPIMI-E and no simv from it, and points both
// variables at build_soc/rtl instead. The two files live in different repos,
// which is how they can drift apart unnoticed; the generated pair is
// self-consistent with nanosoc_system and otherwise port-identical.
$(NANOSOC_CHIP_DIR)/nanosoc_chip.v
// nanosoc_chip_cfg stays in the list for both choices: the generated pad-ring
// instantiates it even though the generated chip does not, and dropping it
// trades the UPIMI errors for one URMI.
$(SOCLABS_NANOSOC_SOC_DIR)/chip/chip/verilog/nanosoc_chip_cfg.v

// NanoSoC Core (generated top-level + glue logic helpers)
-f $(SOCLABS_PROJECT_DIR)/nanosoc_m0_soc/build_soc/flist/nanosoc_toplevel.flist

// NanoSoC System Level
$(SOCLABS_NANOSOC_ARCH_TECH_DIR)/rtl/src/system/nanosoc_system.v

// NanoSoC Subsystems
$(SOCLABS_PROJECT_DIR)/nanosoc_m0_soc/build_soc/rtl/nanosoc_ss_cpu.sv
$(SOCLABS_NANOSOC_ARCH_TECH_DIR)/rtl/src/subsystems/debug/nanosoc_ss_debug.v
$(SOCLABS_NANOSOC_ARCH_TECH_DIR)/rtl/src/subsystems/systemctrl/nanosoc_ss_systemctrl.v
$(SOCLABS_NANOSOC_ARCH_TECH_DIR)/rtl/src/subsystems/dma/nanosoc_dma_wrapper.v
$(SOCLABS_NANOSOC_ARCH_TECH_DIR)/rtl/src/subsystems/dma/nanosoc_ss_dma.sv
$(SOCLABS_NANOSOC_ARCH_TECH_DIR)/rtl/src/subsystems/hostio4/nanosoc_ss_hostio4.v

// Bus Matrix (generated from nanosoc_ahb_interconnect.yaml)
-f $(SOCLABS_PROJECT_DIR)/nanosoc_m0_soc/build_soc/flist/nanosoc_interconnect.flist

// AHB Interconnect Discovery APB Wrapper (hand-written, bridges to peakrdl-regblock)
$(SOCLABS_NANOSOC_SOC_DIR)/build_soc/rtl/nanosoc_ahb_interconnect_discovery/nanosoc_ahb_interconnect_discovery_apb_wrapper.sv

// CPU Subsystem Interconnect
-f $(SOCLABS_PROJECT_DIR)/nanosoc_m0_soc/build_soc/flist/nanosoc_cpu_ss_interconnect.flist

// NanoSoC Regions - Bootrom (generated by bootrom flow)
$(SOCLABS_PROJECT_DIR)/build/firmware/bootloader/stage0/out/nanosoc_region_bootrom.v

// NanoSoC Regions - CPU Memories
$(SOCLABS_NANOSOC_ARCH_TECH_DIR)/rtl/src/regions/imem/nanosoc_region_imem.v
$(SOCLABS_NANOSOC_ARCH_TECH_DIR)/rtl/src/regions/dmem/nanosoc_region_dmem.v

// NanoSoC Regions - Expansion Regions
$(SOCLABS_NANOSOC_ARCH_TECH_DIR)/rtl/src/regions/exp/nanosoc_region_exp.v
$(SOCLABS_NANOSOC_ARCH_TECH_DIR)/rtl/src/regions/sram/nanosoc_region_sram.v

// NanoSoC Regions - DMA Controller Config Region
$(SOCLABS_NANOSOC_ARCH_TECH_DIR)/rtl/src/regions/dmac_ctrl/nanosoc_region_dmac_ctrl.v

// NanoSoC Regions - Soc Peripheral Region
$(SOCLABS_NANOSOC_ARCH_TECH_DIR)/rtl/src/regions/soc_peripheral/nanosoc_region_soc_peripheral.v
$(SOCLABS_NANOSOC_ARCH_TECH_DIR)/rtl/src/regions/soc_peripheral/nanosoc_sysctrl.v
$(SOCLABS_NANOSOC_ARCH_TECH_DIR)/rtl/src/regions/soc_peripheral/nanosoc_soc_peripheral_apb_ss.v
$(SOCLABS_NANOSOC_ARCH_TECH_DIR)/rtl/src/regions/soc_peripheral/nanosoc_soc_peripheral_decode.v

// NanoSoC Regions - SysTable Region
$(SOCLABS_NANOSOC_ARCH_TECH_DIR)/rtl/src/regions/systable/nanosoc_coresight_systable.v
$(SOCLABS_NANOSOC_ARCH_TECH_DIR)/rtl/src/regions/systable/nanosoc_region_systable.v

// NanoSoC Control
$(SOCLABS_NANOSOC_ARCH_TECH_DIR)/rtl/src/control/verilog/nanosoc_clkctrl.v
$(SOCLABS_NANOSOC_ARCH_TECH_DIR)/rtl/src/control/verilog/nanosoc_pin_mux.v


