//-----------------------------------------------------------------------------
// Abstract : Verilog Command File for NanoSoC Testbench
//-----------------------------------------------------------------------------

// ============= Verilog library extensions ===========
+libext+.v+.vlib

// =============    NanoSoC Testbench search path    =============

// - Top-level testbench
$(SOCLABS_NANOSOC_ARCH_TECH_DIR)/verification/tb/verilog/nanosoc_tb_GATE.v
$(SOCLABS_HOSTIO4_TECH_DIR)/target_rtl/hostio4_target.v
$(SOCLABS_HOSTIO4_TECH_DIR)/target_rtl/hostio4_target_fsm.v
$(SOCLABS_HOSTIO4_TECH_DIR)/target_rtl/hostio4_target_sync.v
$(SOCLABS_HOSTIO4_TECH_DIR)/target_rtl/hostio4_target_axis_rxport.v
$(SOCLABS_HOSTIO4_TECH_DIR)/target_rtl/hostio4_target_axis_txport.v

// Include NanoSoC Testbench Components
-f $(SOCLABS_NANOSOC_ARCH_TECH_DIR)/rtl/flist/nanosoc_vip.flist

// Include Corstone VIP Components
-f $(SOCLABS_NANOSOC_ARCH_TECH_DIR)/rtl/flist/corstone101_vip.flist

$(SOCLABS_HOSTIO4_TECH_DIR)/soc_rtl/hostio4_controller_sync.v
$(SOCLABS_GENERIC_LIB_TECH_DIR)/sync/verilog/SYNCHRONIZER_EDGES.v
-f $(SOCLABS_SLCOREM0_TECH_DIR)/flist/slcorem0.flist
-f $(SOCLABS_NANOSOC_ARCH_TECH_DIR)/rtl/flist/corstone101_ip.flist

