# nanosoc SoC family Kconfig (generic). The board selects the concrete SoC and
# fills NUM_IRQS / priority bits to match the generated RTL (compute_ss params).

config SOC_FAMILY_NANOSOC
	bool

config SOC_FAMILY
	default "nanosoc" if SOC_FAMILY_NANOSOC

config SOC_SERIES_NANOSOC_CM4
	bool
	select SOC_FAMILY_NANOSOC

config SOC_SERIES_NANOSOC_CM0P
	bool
	select SOC_FAMILY_NANOSOC

config SOC_NANOSOC_CM4
	bool
	select SOC_SERIES_NANOSOC_CM4
	select CPU_CORTEX_M4
	select CPU_HAS_FPU            # FPU_PRESENT=1 (M4F, single precision)
	select CPU_HAS_ARM_MPU       # MPU_PRESENT=1
	select ARMV7_M_ARMV8_M_FP

config SOC_NANOSOC_CM0P
	bool
	select SOC_SERIES_NANOSOC_CM0P
	select CPU_CORTEX_M0PLUS
	select CPU_HAS_ARM_MPU

config SOC
	default "nanosoc_cm4"  if SOC_NANOSOC_CM4
	default "nanosoc_cm0p" if SOC_NANOSOC_CM0P
