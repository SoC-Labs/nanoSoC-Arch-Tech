# nanosoc SoC family Kconfig.soc (HWMv2 symbol declarations).
#
# Declares the SOC_*/SOC_SERIES_* bool symbols and the SOC_SERIES / SOC string
# defaults. CPU/feature selects live in Kconfig; NUM_IRQS / clock defaults live
# in Kconfig.defconfig. Modeled on soc/arm/designstart and soc/arm/beetle.
#
# Copyright 2026, SoC Labs.
# SPDX-License-Identifier: Apache-2.0

config SOC_FAMILY_NANOSOC
	bool

config SOC_FAMILY
	default "nanosoc" if SOC_FAMILY_NANOSOC

config SOC_SERIES_NANOSOC_CM4
	bool
	select SOC_FAMILY_NANOSOC
	help
	  nanosoc Cortex-M4F compute core series

config SOC_SERIES_NANOSOC_CM0P
	bool
	select SOC_FAMILY_NANOSOC
	help
	  nanosoc Cortex-M0+ manager core series

config SOC_NANOSOC_CM4
	bool
	select SOC_SERIES_NANOSOC_CM4
	help
	  nanosoc Cortex-M4F compute core

config SOC_NANOSOC_CM0P
	bool
	select SOC_SERIES_NANOSOC_CM0P
	help
	  nanosoc Cortex-M0+ manager core

config SOC_SERIES
	default "nanosoc_cm4"  if SOC_SERIES_NANOSOC_CM4
	default "nanosoc_cm0p" if SOC_SERIES_NANOSOC_CM0P

config SOC
	default "nanosoc_cm4"  if SOC_NANOSOC_CM4
	default "nanosoc_cm0p" if SOC_NANOSOC_CM0P
